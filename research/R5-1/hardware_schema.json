{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PenPress Hardware Results",
  "description": "Schema for physical Ender 3 Pro hardware test calibration measurements (~/.penpress/hardware-results.json)",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "machine_name",
    "bed_usable_width_mm",
    "bed_usable_height_mm",
    "measured_clip_keepouts",
    "z_contact_nominal_mm",
    "z_contact_safe_floor_mm",
    "z_lift_clearance_mm",
    "max_reliable_xy_feedrate_mm_min",
    "max_reliable_z_feedrate_mm_min",
    "pen_mount_backlash_x_mm",
    "pen_mount_backlash_y_mm",
    "paper_fit_modes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "machine_name": {
      "type": "string",
      "minLength": 1
    },
    "bed_usable_width_mm": {
      "type": "number",
      "minimum": 150.0,
      "maximum": 300.0
    },
    "bed_usable_height_mm": {
      "type": "number",
      "minimum": 150.0,
      "maximum": 300.0
    },
    "measured_clip_keepouts": {
      "type": "object",
      "required": ["left_mm", "right_mm", "bottom_mm", "top_mm"],
      "properties": {
        "left_mm": { "type": "number", "minimum": 0.0, "maximum": 50.0 },
        "right_mm": { "type": "number", "minimum": 0.0, "maximum": 50.0 },
        "bottom_mm": { "type": "number", "minimum": 0.0, "maximum": 50.0 },
        "top_mm": { "type": "number", "minimum": 0.0, "maximum": 50.0 }
      }
    },
    "z_contact_nominal_mm": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 10.0
    },
    "z_contact_safe_floor_mm": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 5.0
    },
    "z_lift_clearance_mm": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 15.0
    },
    "max_reliable_xy_feedrate_mm_min": {
      "type": "number",
      "minimum": 600.0,
      "maximum": 12000.0
    },
    "max_reliable_z_feedrate_mm_min": {
      "type": "number",
      "minimum": 300.0,
      "maximum": 3000.0
    },
    "pen_mount_backlash_x_mm": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "pen_mount_backlash_y_mm": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "paper_fit_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["A5_single_pass", "A4_two_pass_unsupported", "US_Letter_single_pass"]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
